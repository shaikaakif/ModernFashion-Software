{
  "name": "modern-fashion-pos",
  "productName": "Modern Fashion POS",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Offline-first Windows retail POS and inventory management for Modern Fashion (Brand Hub), Attapur, Hyderabad.",
  "author": "Meninges Labs",
  "license": "SEE LICENSE IN LICENSE",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "lint": "eslint src electron tests scripts --ext js,jsx,mjs --max-warnings 0",
    "test": "node --test \"tests/*.test.js\"",
    "verify": "npm run test && npm run build && npm run lint",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:publish": "npm run build && electron-builder --win nsis --publish always",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "antd": "^5.29.0",
    "dayjs": "^1.11.10",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsbarcode": "^3.12.3",
    "prettier": "3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.0",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.meningeslabs.modernfashion.pos",
    "productName": "Modern Fashion POS",
    "copyright": "Copyright (c) Meninges Labs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "shaikaakif",
        "repo": "ModernFashion-Software",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ModernFashionPOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Modern Fashion POS",
      "uninstallDisplayName": "Modern Fashion POS",
      "deleteAppDataOnUninstall": false
    }
  }
}
